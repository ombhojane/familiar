# ---- Perception (cheap multimodal: screenshot -> structured JSON) ----
OPENAI_API_KEY=sk-...
PERCEPTION_MODEL=gpt-5.6-luna

# ---- Cognition (the TrueForge agent model) ----
COGNITION_MODEL=gpt-5.6-terra

# ---- TrueForge ----
TRUEFORGE_BASE_URL=http://localhost:8790

# ---- familiar-mcp ----
PORT=3333
SQLITE_PATH=./data/familiar.db
CAPTURE_DIR=./captures

# ---- Real irreversible action ----
# DEMO_MODE unset  -> Porkbun SANDBOX keys (what judges run; fully functional)
# DEMO_MODE=live   -> Porkbun LIVE keys (what the video shows)
DEMO_MODE=
PORKBUN_API_KEY=pk1_sb_...
PORKBUN_SECRET_KEY=sk1_sb_...
PORKBUN_LIVE_API_KEY=
PORKBUN_LIVE_SECRET_KEY=
