# ---- Perception (cheap multimodal: screenshot -> structured JSON) ----
OPENAI_API_KEY=sk-...
PERCEPTION_MODEL=gpt-5.6-luna

# ---- Cognition (the TrueForge agent model) ----
COGNITION_MODEL=gpt-5.6-terra

# ---- TrueForge ----
TRUEFORGE_BASE_URL=http://localhost:8790

# ---- familiar-mcp ----
PORT=3333
SQLITE_PATH=./data/familiar.db
CAPTURE_DIR=./captures

# ---- Real actions (uses the already-authenticated `gh` CLI; no new credentials) ----
# DEMO_MODE unset -> dry run: reports exactly what WOULD happen, changes nothing (the judge path)
# DEMO_MODE=live  -> performs the real action (what the video shows)
DEMO_MODE=
TARGET_REPO=ombhojane/familiar
